# --- Free LLM via Pollinations.ai (no API key needed; heuristic fallback if offline) ---
LLM_MODEL=openai
LLM_URL=https://text.pollinations.ai/openai
# LLM_OFFLINE=1  # uncomment to force heuristic (no network calls)

# --- Hindsight (optional; local JSON fallback works without it) ---
# For Hindsight Cloud, set the server URL + API key:
HINDSIGHT_BASE_URL=
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=incident-response-bank-v2

PORT=8000
