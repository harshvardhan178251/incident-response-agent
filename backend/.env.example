# --- Free LLM via Pollinations.ai (no API key needed; heuristic fallback if offline) ---
# Override the model / endpoint, or set LLM_OFFLINE=1 to force the heuristic.
LLM_MODEL=openai
LLM_URL=https://text.pollinations.ai/openai

# --- Hindsight Cloud ---
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=your-key-here
HINDSIGHT_BANK_ID=incident-response-bank-v2

PORT=8010
